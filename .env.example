# Copy to .env.local and fill in.
#
# For local development the Supabase values come from `pnpm exec supabase
# status` after `pnpm exec supabase start`. They are the same on every local
# install and only reach a database on 127.0.0.1. For a deployed environment
# take them from the Supabase dashboard (Project Settings -> API).
#
# NEXT_PUBLIC_ is correct on the two below. The publishable key is designed to
# be sent to the browser -- RLS is what gates it. CLAUDE.md's "never
# NEXT_PUBLIC_" rule is about the TMDB provider key, which is unrelated and
# arrives in phase 1a. Do not "fix" these; the browser client needs them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Everything below is server-side only. This repo is public: prefixing any of
# them with NEXT_PUBLIC_ ships the secret to the browser.

# Bypasses RLS. The catalog tables have no write policies, so this is what the
# provider write-through in lib/movies/cache.ts writes with.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB v4 Read Access Token (themoviedb.org -> Settings -> API), sent as
# `Authorization: Bearer ...`. Not the 32-character v3 key.
TMDB_API_KEY=

# Google OAuth client, from Google Cloud Console -> APIs & Services ->
# Credentials. Only needed for local dev -- supabase/config.toml's env()
# substitution reads these to configure the local GoTrue instance's Google
# provider. The hosted project's equivalent lives in the Supabase dashboard,
# not here.
#
# IMPORTANT: the Supabase CLI's env() only reads a root-level `.env` file,
# never `.env.local` -- that's Next.js's file, and the CLI doesn't look at
# it. These two need their own `.env` (also gitignored by `.env*` below) or
# `supabase start` will resolve empty strings and Google sign-in will fail
# locally with "provider is disabled" even though enabled = true above.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
